DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kudaidem"

# Telegram WebApp initData verification for persistent rooms.
TELEGRAM_BOT_TOKEN=""

# Stage 7 closed beta. Keep BETA_MODE=0 for unrestricted local development.
BETA_MODE="0"
BETA_SESSION_SECRET="replace-with-long-random-secret"
OPS_DASHBOARD_TOKEN="replace-with-ops-token"

# OpenStreetMap/Overpass collection targets.
TARGET_PLACES="200"
TARGET_PHOTOS="200"

# Review-only switch. Keep disabled in public production until photo rights are approved.
NEXT_PUBLIC_ALLOW_REVIEW_PHOTOS="0"

# Licensed 2GIS Places API integration. Public HTML pages are not scraped.
DGIS_API_KEY=""
DGIS_MEDIA_RIGHTS_APPROVED="0"
